        }
      }
    },
    "Voronoi procedural background — animated double-pass Voronoi with anti-aliased edges, 1–5 color cell ramp, optional gap border between cells, and radial inner glow shadow. Tap the gear to tune palette, density, distortion, gap, glow, and motion." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "泰森多边形程序化背景：带抗锯齿边缘的双层 Voronoi 动画，1–5 色单元色阶，可选单元间隙描边和径向内发光阴影。点齿轮可调节配色、密度、扭曲、间隙、辉光和运动。"
          }
        }
      }
    },
