    "Simplex Noise Controls" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单纯形噪声控制"
          }
        }
      }
    },
    "Simplex-noise procedural background — two layered 2D simplex noises drive a 1–10 color gradient with stepped smooth transitions and wrap-around seam blending. Tap the gear to tune palette (add/remove colors), scale, steps per color, softness, and motion." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单纯形噪声程序化背景：两层 2D 单纯形噪声驱动 1–10 色渐变，分级平滑过渡，并对环绕接缝做混合。点齿轮可调节配色（增删颜色）、缩放、每色级数、柔和度和运动。"
          }
        }
      }
    },
    "Skew" : {
